rules_version = '2';

// BarTalk security rules.
//
// The tracking rules carry a property the client cannot be trusted to keep on
// its own: a tracker can only read someone's position while a watch session
// exists, and a watch session is exactly what causes that person to be
// notified. Seeing therefore cannot happen without telling — not by a modified
// client, not by a direct API call.
//
// NOTE: this file is new. Rules for this project were previously managed in the
// Firebase console; review it against what is live before deploying.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function nowMs() {
      return request.time.toMillis();
    }

    // Client clocks drift; five minutes of slack still prevents a tracker
    // backdating a session to make a long look read as a short one.
    function isPlausibleTimestamp(value) {
      return value is number
        && value > nowMs() - 300000
        && value < nowMs() + 300000;
    }

    function linkId(trackerId, trackeeId) {
      return trackerId + '__' + trackeeId;
    }

    function linkFor(trackerId, trackeeId) {
      return get(
        /databases/$(database)/documents/trackingLinks/$(linkId(trackerId, trackeeId))
      ).data;
    }

    // Whether this tracker may currently look at this trackee at all.
    //
    // Pausing has to be checked here, not only on the position document. It
    // already emptied `sharedWith`, so a paused trackee's location was never
    // readable — but a watch session could still be opened, which notified them
    // that someone was checking on them while that someone saw nothing. A
    // notification for a look that revealed nothing is a false alarm, and false
    // alarms are how a person learns to ignore the real ones. Pausing means
    // nobody is looking, not merely that nobody succeeds.
    function isSharingWith(trackerId, trackeeId) {
      return exists(
        /databases/$(database)/documents/trackingLinks/$(linkId(trackerId, trackeeId))
      )
        && linkFor(trackerId, trackeeId).status == 'active'
        && linkFor(trackerId, trackeeId).pausedByTrackee == false;
    }

    // The hard ceiling on one look. Mirrors WATCH_SESSION_MAX_MS in
    // tracking/constants.ts; both must move together.
    function watchCeilingMs() {
      return 60000;
    }

    function watchSession(trackerId, trackeeId) {
      return get(
        /databases/$(database)/documents/watchSessions/$(linkId(trackerId, trackeeId))
      ).data;
    }

    // A look is live only while it is both open and inside the ceiling. The
    // second half is what makes the ceiling real rather than a courtesy: a
    // tracker running a modified client can keep the session marked active and
    // keep heartbeating, and still be denied the position the moment the minute
    // is up. Ending is not something the app does — it is something the
    // database does.
    function isWatching(trackerId, trackeeId) {
      return exists(
        /databases/$(database)/documents/watchSessions/$(linkId(trackerId, trackeeId))
      )
        && watchSession(trackerId, trackeeId).active == true
        && watchSession(trackerId, trackeeId).startedAt is number
        && nowMs() - watchSession(trackerId, trackeeId).startedAt
             < watchCeilingMs();
    }

    // ---------------- Users ----------------
    // The directory is readable by any signed-in user, which is what the
    // contacts list is built from. Each user owns only their own document.
    match /Users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if false;
    }

    // ---------------- Messaging ----------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isSignedIn()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() && uid() in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function participants() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;
        }

        allow read: if isSignedIn() && uid() in participants();
        allow create: if isSignedIn()
          && uid() in participants()
          && request.resource.data.sender == uid();
        allow update, delete: if isSignedIn() && uid() in participants();
      }
    }

    // ---------------- Tracking links ----------------
    // A tracker may ask; only the trackee may grant, pause or withdraw.
    match /trackingLinks/{id} {
      // resource is null when the document doesn't exist; without this guard a
      // first-time "have we already asked this person?" check is denied rather
      // than simply coming back empty.
      allow read: if isSignedIn()
        && (resource == null || uid() in resource.data.members);

      // Links written before guardianship existed carry no kind at all, and a
      // link with no kind is a friendship — the only thing links used to be.
      function kindOf(data) {
        return data.get('kind', 'friend');
      }

      allow create: if isSignedIn()
        && request.resource.data.trackerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.pausedByTrackee == false
        && id == linkId(
          request.resource.data.trackerId,
          request.resource.data.trackeeId
        )
        && request.resource.data.members.hasOnly([
          request.resource.data.trackerId,
          request.resource.data.trackeeId
        ])
        // A client may only ever create a friendship. Guardianship is created
        // by a Cloud Function, after a pairing code has been redeemed on the
        // dependant's own device — because a tracker who could simply declare
        // someone a dependant could strip that person's controls at will, and
        // "dependant" is exactly the label that would be abused.
        && kindOf(request.resource.data) == 'friend';

      // Neither side may rewrite who the link is between.
      function participantsUnchanged() {
        return request.resource.data.trackerId == resource.data.trackerId
          && request.resource.data.trackeeId == resource.data.trackeeId
          && request.resource.data.members == resource.data.members;
      }

      // What a link is cannot change. A friendship cannot be promoted into
      // guardianship, and guardianship cannot be quietly downgraded to hide
      // that it ever existed.
      function kindUnchanged() {
        return kindOf(request.resource.data) == kindOf(resource.data);
      }

      // A friend decides everything about being seen.
      function friendUpdate() {
        return (uid() == resource.data.trackeeId
            && request.resource.data.status in ['active', 'declined', 'revoked'])
          // The tracker may only re-ask or withdraw their own request. They can
          // never move a link to 'active' — that is the trackee's consent.
          || (uid() == resource.data.trackerId
            && request.resource.data.status in ['pending', 'revoked']
            && request.resource.data.pausedByTrackee == resource.data.pausedByTrackee);
      }

      // A dependant does not consent to each look and cannot pause one. What
      // they keep is the exit, and the record: they may always ask to be
      // released, and they always see every entry in their own history.
      function dependantUpdate() {
        return request.resource.data.pausedByTrackee == false && (
          // The guardian may end it whenever they like.
          (uid() == resource.data.trackerId
            && request.resource.data.status in ['active', 'revoked'])
          // The dependant may touch nothing except the request to be let go.
          // releaseEffectiveAt is pinned to the delay rather than left to the
          // client, or asking to leave and leaving would be the same act.
          || (uid() == resource.data.trackeeId
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['releaseRequestedAt', 'releaseEffectiveAt', 'updatedAt'])
            // Read through get() with a default: reaching for a field that
            // isn't in the write throws, and a rule that throws denies whatever
            // else it was in the middle of deciding.
            && isPlausibleTimestamp(
                 request.resource.data.get('releaseRequestedAt', 0))
            && request.resource.data.get('releaseEffectiveAt', 0) ==
                 request.resource.data.get('releaseRequestedAt', 0) + 86400000)
        );
      }

      // Sharing health is mirrored by the server from the position document. If
      // a client could write it, a trackee could report themselves as sharing
      // while publishing nothing — which is exactly the evasion it exists to
      // surface — and a tracker could forge a gap that never happened.
      function noServerHealthFields() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['trackeeLastPublishedAt', 'trackeePermissionState']);
      }

      allow update: if isSignedIn()
        && participantsUnchanged()
        && kindUnchanged()
        && noServerHealthFields()
        && (
          kindOf(resource.data) == 'dependant' ?
            dependantUpdate() :
            friendUpdate()
        );

      allow delete: if false;
    }

    // ---------------- Pairing codes ----------------
    // Guardianship is established by handing over the phone, which is what the
    // whole industry uses as proof of authority. A code is minted for the
    // guardian and redeemed on the dependant's device, both through Cloud
    // Functions — so no client ever reads a code it was not given, and no
    // client can spend one twice or after it expires.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // ---------------- Positions ----------------
    // Written only by the person they describe. Read only by someone that
    // person is actively sharing with AND who currently has a watch session
    // open — which is to say, someone the trackee has just been told about.
    match /locations/{userId} {
      allow read: if isSignedIn() && (
        resource == null
        || uid() == userId
        || (uid() in resource.data.sharedWith && isWatching(uid(), userId))
      );
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if isSignedIn() && uid() == userId;
    }

    // ---------------- Watch sessions ----------------
    // The record of someone looking. Written by the tracker, readable by both,
    // and deletable by nobody: the trackee must never be able to hide that they
    // were watched, and the tracker must never be able to hide that they
    // watched.
    match /watchSessions/{id} {
      allow read: if isSignedIn() && (
        resource == null
        || uid() == resource.data.trackerId
        || uid() == resource.data.trackeeId
      );

      // notifiedAt and wakePushedAt are the server's cooldown bookkeeping. If a
      // client could write them, a tracker could pre-set notifiedAt and look
      // without the trackee ever being told.
      function noServerFieldsOnCreate() {
        return !request.resource.data.keys().hasAny([
          'notifiedAt', 'wakePushedAt'
        ]);
      }

      function noServerFieldsOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'notifiedAt', 'wakePushedAt'
        ]);
      }

      allow create: if isSignedIn()
        && request.resource.data.trackerId == uid()
        && id == linkId(uid(), request.resource.data.trackeeId)
        && request.resource.data.active == true
        && isPlausibleTimestamp(request.resource.data.startedAt)
        && isPlausibleTimestamp(request.resource.data.lastHeartbeatAt)
        && noServerFieldsOnCreate()
        && isSharingWith(uid(), request.resource.data.trackeeId);

      allow update: if isSignedIn()
        && uid() == resource.data.trackerId
        && request.resource.data.trackerId == resource.data.trackerId
        && request.resource.data.trackeeId == resource.data.trackeeId
        && noServerFieldsOnUpdate()
        && (
          // Reopening a session, or heartbeating / closing an open one.
          (request.resource.data.active == true
            && (
              // Reopening a closed session. A fresh start time is allowed here
              // and only here, because this same write flips active back on —
              // which is exactly what makes the Cloud Function notify again.
              (resource.data.active == false
                && isPlausibleTimestamp(request.resource.data.startedAt))
              // Heartbeating a live one. startedAt is immutable while active,
              // or a tracker could hold one session open and keep sliding its
              // start time forward, watching indefinitely without ever
              // crossing the inactive -> active edge that notifies. Restarting
              // must cost a close, and a close is announced too.
              || (request.resource.data.startedAt == resource.data.startedAt
                && nowMs() - resource.data.startedAt < watchCeilingMs())
            )
            && isPlausibleTimestamp(request.resource.data.lastHeartbeatAt)
            && isSharingWith(uid(), resource.data.trackeeId))
          || request.resource.data.active == false
        );

      allow delete: if false;
    }

    // ---------------- Watch history ----------------
    // Written only by the Cloud Function, which bypasses these rules. No device
    // can forge an entry or erase one.
    match /trackingEvents/{eventId} {
      allow read: if isSignedIn() && (
        uid() == resource.data.trackeeId || uid() == resource.data.trackerId
      );
      allow write: if false;
    }
  }
}
