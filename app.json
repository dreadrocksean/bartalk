{
  "expo": {
    "name": "BarTalk",
    "slug": "BarTalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bartalk",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "This app uses notifications to alert you of new messages.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.dreadrocksoftware.bartalk"
    },
    "android": {
      "package": "com.dreadrocksoftware.bartalk",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "./plugins/with-rnfirebase-static-framework.js",
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BarTalk needs access to your photos so you can send images in chat."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "BarTalk needs access to your photos so you can send images in chat.",
          "savePhotosPermission": "BarTalk saves photos and videos from your chats to your library when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BarTalk shares your location with the people you have approved, including when the app is closed, so they can see you on the map. You are notified every time one of them checks.",
          "locationWhenInUsePermission": "BarTalk shows your location to the people you have approved while you are using the app. You are notified every time one of them checks.",
          "locationAlwaysPermission": "BarTalk shares your location with the people you have approved, including when the app is closed. You are notified every time one of them checks.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35b39fb6-7c51-4ede-9665-5ed38f5037f2"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/35b39fb6-7c51-4ede-9665-5ed38f5037f2",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
